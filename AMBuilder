import os

projectName = 'socket'

for cxx in builder.targets:
  binary = SM.ExtLibrary(builder, cxx, projectName + ".ext")

  binary.compiler.defines += [
    'HAVE_STRING_H',
  ]

  if cxx.target.platform == 'linux':
    cxx.postlink += ['-lpthread', '-lrt']
  elif cxx.target.platform == 'mac':
    cxx.cflags += ['-Wno-deprecated-declarations']
    cxx.postlink += ['-framework', 'CoreServices']

  if cxx.target.platform == 'windows':
    binary.compiler.defines += [
      # Boost is linked by path below; its auto-link pragmas would ask for versioned file names.
      'BOOST_ALL_NO_LIB',
      # windows.h comes before Boost in some files and after it in others: keep Asio consistent.
      '_WIN32_WINNT=0x0601',
    ]

  if cxx.family == 'gcc' or cxx.family == 'clang':
    cxx.cxxflags += ['-fno-rtti']
  elif cxx.family == 'msvc':
    cxx.cxxflags += ['/GR-']

  # Boost built per arch: build/ (x86) and build64/ (x86_64); a single-arch build may only have build/.
  boost_lib = os.path.join(SM.libboost_root, 'build64' if cxx.target.arch == 'x86_64' else 'build', 'lib')
  if not os.path.isdir(boost_lib):
    boost_lib = os.path.join(SM.libboost_root, 'build', 'lib')
  boost_ext = '.lib' if cxx.target.platform == 'windows' else '.a'
  binary.compiler.postlink += [
    os.path.join(boost_lib, 'libboost_thread' + boost_ext),
    os.path.join(boost_lib, 'libboost_system' + boost_ext),
  ]

  binary.sources += [
    'Extension.cpp',
    'Socket.cpp',
    'SocketHandler.cpp',
    'Callback.cpp',
    'CallbackHandler.cpp',
    os.path.join(SM.sm_root, 'public', 'smsdk_ext.cpp'),
  ]

  SM.AddCDetour(binary)
  SM.extensions += [builder.Add(binary)]
